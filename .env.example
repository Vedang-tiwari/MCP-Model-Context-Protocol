# MCP Job Scout & Application Agent Configuration

# Open-Source Baseline Model Configuration for Orchestration & Tool Calling:
# Option A (Recommended Cloud): Groq (Free, ultra-fast 300+ tok/s with Llama 3.3 70B or Qwen 2.5 32B)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_free_groq_api_key_here

# Option B (100% Local & Free): Ollama (Run offline with zero API keys)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Option C: DeepSeek / OpenAI / Anthropic
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_PATH=data/mcp_jobs.db

# Browser Automation & Anti-Bot Stealth
PLAYWRIGHT_HEADLESS=false
BROWSER_USER_DATA_DIR=data/browser_profile
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# Human-In-The-Loop (HITL) Alerting
# Set up a free Telegram Bot via @BotFather to get instant mobile alerts when a job is applied or CAPTCHA appears
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (alternative notification channel)
DISCORD_WEBHOOK_URL=

# Model Context Protocol (MCP) Server Settings
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
